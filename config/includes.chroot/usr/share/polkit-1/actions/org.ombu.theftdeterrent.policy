<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.ombu.theftdeterrent">
    <description>Instalar, revisar o quitar el Theft Deterrent</description>
    <message>Para instalar o quitar la protección antirrobo hace falta la clave de administrador.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ombu/theft-deterrent/ombu-td-root</annotate>
  </action>
</policyconfig>
