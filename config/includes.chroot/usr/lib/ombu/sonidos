#!/bin/sh
# Ombú: sonidos del sistema que XFCE no trae solos.
#   - Sonido al iniciar la sesión.
#   - Sonido al conectar y al desconectar un dispositivo USB (pendrive, mouse, etc.).
#   - Sonido al vaciar la papelera.
# Los demás sonidos (avisos, errores, preguntas) los dan las propias aplicaciones con el tema de sonidos «freedesktop».
SND=/usr/share/sounds/freedesktop/stereo
LOG="$HOME/.cache/ombu-sonidos.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null
registro() { printf '%s  %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }
[ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 200 ] && tail -n 100 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"

# tocar ARCHIVO: devuelve 0 si el sonido se reprodujo de verdad (si dura menos de 1 s, el audio todavía no estaba listo)
tocar() {
    [ -f "$1" ] || return 1
    t0=$(date +%s%N 2>/dev/null || echo 0)
    pw-play "$1" >/dev/null 2>&1; rc=$?
    t1=$(date +%s%N 2>/dev/null || echo 0)
    ms=$(( (t1 - t0) / 1000000 ))
    registro "pw-play $(basename "$1") rc=$rc ${ms}ms"
    [ "$rc" -eq 0 ] && [ "$ms" -ge 500 ]
}

# Esperar a que el audio esté listo (hasta 40 s): que PipeWire responda Y que exista la salida de audio predeterminada
registro "inicio de sonidos"
i=0
while [ "$i" -lt 40 ]; do
    wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1 && break
    i=$((i+1)); sleep 1
done
registro "audio listo tras ${i} s"
sleep 3
INICIO=/usr/share/ombu/sonidos/inicio.wav
[ -f "$INICIO" ] || INICIO="$SND/service-login.oga"
tocar "$INICIO" || { sleep 3; tocar "$INICIO"; }          # si salió demasiado corto, se reintenta una vez

# USB: sonido al conectar y al desconectar. Se mira solo el dispositivo (no cada una de sus interfaces) para que suene una vez.
(
    accion=""
    udevadm monitor --udev --subsystem-match=usb --property 2>/dev/null | while IFS= read -r linea; do
        case "$linea" in
            ACTION=add)    accion=add ;;
            ACTION=remove) accion=remove ;;
            DEVTYPE=usb_device)
                case "$accion" in
                    add)    registro "USB conectado";    tocar "$SND/device-added.oga" ;;
                    remove) registro "USB desconectado"; tocar "$SND/device-removed.oga" ;;
                esac
                accion="" ;;
            "") accion="" ;;
        esac
    done
) &

# Papelera: se avisa cuando pasa de tener cosas a estar vacía
T="$HOME/.local/share/Trash/files"
cuenta() { ls -A "$T" 2>/dev/null | wc -l; }
antes="$(cuenta)"
while sleep 1; do
    ahora="$(cuenta)"
    if [ "$antes" -gt 0 ] && [ "$ahora" -eq 0 ]; then
        tocar "$SND/trash-empty.oga"
    fi
    antes="$ahora"
done
