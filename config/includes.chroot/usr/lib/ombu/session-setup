#!/bin/sh
# Se ejecuta al iniciar sesión (XFCE). Prepara el escritorio del usuario.
DESK="$(xdg-user-dir DESKTOP 2>/dev/null)"
[ -n "$DESK" ] || DESK="$HOME/Escritorio"
mkdir -p "$DESK"

# Carpetas personales (Mis Documentos, Mis Descargas, Mis Imágenes, Mi Música, Mis Videos): se crean si faltan
# y aparecen en el panel izquierdo del explorador de archivos.
for v in DOWNLOAD DOCUMENTS MUSIC PICTURES VIDEOS; do
    d="$(xdg-user-dir $v 2>/dev/null)"
    [ -n "$d" ] && [ "$d" != "$HOME" ] && mkdir -p "$d"
done
mkdir -p "$HOME/.config/gtk-3.0"
{
    for v in DOCUMENTS DOWNLOAD PICTURES MUSIC VIDEOS; do
        d="$(xdg-user-dir $v 2>/dev/null)"
        [ -n "$d" ] && [ "$d" != "$HOME" ] && printf '%s %s\n' "$(python3 -c 'import sys,urllib.parse as u;print("file://"+u.quote(sys.argv[1]))' "$d")" "$(basename "$d")"
    done
} > "$HOME/.config/gtk-3.0/bookmarks" 2>/dev/null

# En sesión live: la pantalla no se apaga ni se bloquea (la instalación puede tardar y no hay actividad)
if grep -qw 'boot=live' /proc/cmdline; then
    xset s off s noblank -dpms 2>/dev/null
    for p in dpms-enabled; do
        xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/$p -n -t bool -s false 2>/dev/null \
            || xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/$p -s false 2>/dev/null
    done
    for p in blank-on-ac blank-on-battery; do
        xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/$p -n -t int -s 0 2>/dev/null \
            || xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/$p -s 0 2>/dev/null
    done
fi

# En sesión live: ícono para instalar Ombú
if grep -qw 'boot=live' /proc/cmdline; then
    cp -f /usr/share/applications/ombu-instalar.desktop "$DESK/"
fi

# Lanzadores de confianza (XFCE exige ejecutable + checksum guardado con gio).
# Requiere el paquete libglib2.0-bin (comando gio). Si falla, queda registrado.
LOG="$HOME/.cache/ombu-session-setup.log"
mkdir -p "$(dirname "$LOG")"
for f in "$DESK"/*.desktop; do
    [ -f "$f" ] || continue
    chmod +x "$f"
    sum="$(sha256sum "$f" | cut -d' ' -f1)"
    gio set "$f" metadata::xfce-exe-checksum "$sum" 2>>"$LOG" \
        || echo "No se pudo marcar como seguro: $f" >>"$LOG"
done

# Fondo de pantalla: se fija para cada monitor conectado (los nombres varían: LVDS-1, eDP-1, Virtual-1...)
IMG=/usr/share/ombu/wallpapers/ombu.png
fijar_fondo() {
    command -v xfconf-query >/dev/null 2>&1 || return 0
    OUTPUTS="$(xrandr --query 2>/dev/null | awk '/ connected/{print $1}')"
    [ -n "$OUTPUTS" ] || OUTPUTS="default"
    for o in $OUTPUTS; do
        base="/backdrop/screen0/monitor$o/workspace0"
        xfconf-query -c xfce4-desktop -p "$base/last-image" -n -t string -s "$IMG" 2>/dev/null \
            || xfconf-query -c xfce4-desktop -p "$base/last-image" -s "$IMG" 2>/dev/null
        xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5 2>/dev/null \
            || xfconf-query -c xfce4-desktop -p "$base/image-style" -s 5 2>/dev/null
    done
    for p in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep 'last-image$'); do
        xfconf-query -c xfce4-desktop -p "$p" -s "$IMG" 2>/dev/null
    done
    # Si xfdesktop arrancó antes de que se fijara el fondo, que vuelva a leer la configuración
    command -v xfdesktop >/dev/null 2>&1 && xfdesktop --reload >/dev/null 2>&1
}
fijar_fondo
# xfdesktop a veces escribe su fondo por defecto después de este script (carrera al iniciar la sesión):
# se vuelve a fijar unos segundos más tarde, en segundo plano.
( sleep 6; fijar_fondo; sleep 10; fijar_fondo ) >/dev/null 2>&1 &

# Perfil visual (base o completo, según el equipo): ver /usr/lib/ombu/perfil
[ -x /usr/lib/ombu/perfil ] && /usr/lib/ombu/perfil

# Volumen en 75 %: en la sesión live y en el primer inicio de cada usuario (después se respeta lo que elija la persona).
# Se espera a que el audio esté listo (hasta 30 s) y se desactiva el silencio.
MARCA="$HOME/.cache/ombu-volumen-inicial"
if grep -qw 'boot=live' /proc/cmdline || [ ! -e "$MARCA" ]; then
    (
        i=0
        while [ "$i" -lt 30 ]; do
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.75 2>/dev/null && { wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null; break; }
            i=$((i+1)); sleep 1
        done
        mkdir -p "$(dirname "$MARCA")"; : > "$MARCA"
    ) >/dev/null 2>&1 &
fi

# Micrófono: con el ALSA de fábrica la captura queda al 100 % (+30 dB) y «Mic Boost» al máximo (+36 dB): la grabación se satura
# (en la G7 se recortó el 15 % de las muestras). Se baja a un valor razonable, una sola vez por usuario.
MARCA_MIC="$HOME/.cache/ombu-mic-inicial"
if [ ! -e "$MARCA_MIC" ] && command -v amixer >/dev/null 2>&1; then
    (
        sleep 8
        for card in $(awk -F'[][]' '/^ *[0-9]+ \[/{print $1}' /proc/asound/cards 2>/dev/null | tr -d ' '); do
            amixer -q -c "$card" sset 'Capture' 55% 2>/dev/null
            amixer -q -c "$card" sset 'Mic Boost' 1 2>/dev/null
            amixer -q -c "$card" sset 'Internal Mic Boost' 1 2>/dev/null
        done
        mkdir -p "$(dirname "$MARCA_MIC")"; : > "$MARCA_MIC"
    ) >/dev/null 2>&1 &
fi

# Orden de los íconos del escritorio (una sola vez por usuario): Mi Equipo, Papelera y el resto por orden alfabético.
# Se espera a que xfdesktop haya cargado todos los lanzadores.
MARCA2="$HOME/.cache/ombu-iconos-ordenados-1"
if [ ! -e "$MARCA2" ] && [ -x /usr/lib/ombu/ordenar-escritorio ]; then
    (
        i=0
        while [ "$i" -lt 30 ] && ! pgrep -x xfdesktop >/dev/null 2>&1; do i=$((i+1)); sleep 1; done
        sleep 8
        /usr/lib/ombu/ordenar-escritorio && { mkdir -p "$(dirname "$MARCA2")"; : > "$MARCA2"; }
    ) >/dev/null 2>&1 &
fi
exit 0
