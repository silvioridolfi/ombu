[Unit]
Description=Ombú: zona horaria de Buenos Aires en la sesión en vivo
After=live-config.service
ConditionKernelCommandLine=boot=live

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'ln -sf /usr/share/zoneinfo/America/Argentina/Buenos_Aires /etc/localtime; echo America/Argentina/Buenos_Aires > /etc/timezone'

[Install]
WantedBy=multi-user.target
