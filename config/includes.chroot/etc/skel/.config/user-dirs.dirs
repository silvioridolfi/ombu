# Carpetas del usuario en español (Ombú): nombres al estilo "Mis ..."
XDG_DESKTOP_DIR="$HOME/Escritorio"
XDG_DOWNLOAD_DIR="$HOME/Mis Descargas"
XDG_TEMPLATES_DIR="$HOME"
XDG_PUBLICSHARE_DIR="$HOME"
XDG_DOCUMENTS_DIR="$HOME/Mis Documentos"
XDG_MUSIC_DIR="$HOME/Mi Música"
XDG_PICTURES_DIR="$HOME/Mis Imágenes"
XDG_VIDEOS_DIR="$HOME/Mis Videos"
